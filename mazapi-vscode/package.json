{
  "name": "mazapi-scanner",
  "displayName": "MazAPI Scanner",
  "description": "Scan APIs for OWASP / MITRE / CWE vulnerabilities directly from VS Code. Detects hardcoded endpoints and API keys in your code.",
  "version": "1.0.0",
  "publisher": "MazAPI",
  "repository": { "type": "git", "url": "https://github.com/Mazonia/mazapi" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Linters"],
  "keywords": ["api", "security", "owasp", "scanner", "vulnerability"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mazapi.scanFile",
        "title": "MazAPI: Scan Current File for API Issues"
      },
      {
        "command": "mazapi.scanWorkspace",
        "title": "MazAPI: Scan Entire Workspace for API Issues"
      },
      {
        "command": "mazapi.scanEndpoint",
        "title": "MazAPI: Scan This API Endpoint",
        "category": "MazAPI"
      },
      {
        "command": "mazapi.openPanel",
        "title": "MazAPI: Open Results Panel"
      },
      {
        "command": "mazapi.exportSARIF",
        "title": "MazAPI: Export Last Scan as SARIF"
      },
      {
        "command": "mazapi.exportHTML",
        "title": "MazAPI: Export Last Scan as HTML Report"
      },
      {
        "command": "mazapi.configureWebhook",
        "title": "MazAPI: Configure Webhook Alert URL"
      },
      {
        "command": "mazapi.filter.configure",
        "title": "MazAPI: Configure Findings Filter",
        "icon": "$(filter)"
      },
      {
        "command": "mazapi.filter.reset",
        "title": "MazAPI: Reset Filter (show all findings)",
        "icon": "$(filter-filled)"
      },
      {
        "command": "mazapi.scanWorkspace",
        "title": "MazAPI: Scan Entire Workspace",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mazapi.scanEndpoint",
          "when": "editorTextFocus",
          "group": "MazAPI"
        }
      ],
      "view/title": [
        {
          "command": "mazapi.scanWorkspace",
          "when": "view == mazapi.findings",
          "group": "navigation@1"
        },
        {
          "command": "mazapi.filter.configure",
          "when": "view == mazapi.findings",
          "group": "navigation@2"
        },
        {
          "command": "mazapi.filter.reset",
          "when": "view == mazapi.findings && mazapi.filterActive",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "MazAPI Scanner",
      "properties": {
        "mazapi.backendUrl": {
          "type": "string",
          "default": "http://localhost:9000",
          "description": "URL of your MazAPI backend (optional — used for full OWASP scans)"
        },
        "mazapi.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Continuously scan files for security issues as you open and edit them (results appear in the Findings panel and Problems tab)"
        },
        "mazapi.autoScanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Scan for security issues when a file is saved (legacy — use autoScan instead)"
        },
        "mazapi.webhookUrl": {
          "type": "string",
          "default": "",
          "description": "Slack or Teams webhook URL to send scan alerts to"
        },
        "mazapi.orgName": {
          "type": "string",
          "default": "",
          "description": "Organisation name shown in HTML reports"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mazapi",
          "title": "MazAPI Scanner",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mazapi": [
        { "id": "mazapi.findings",  "name": "Findings" },
        { "id": "mazapi.endpoints", "name": "Detected Endpoints" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
