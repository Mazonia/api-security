{
  "manifest_version": 3,
  "name": "MazAPI Scanner & BOLT Security Suite",
  "version": "2.3.0",
  "description": "Enterprise API & AI Security Scanner. Side Panel inspection, AST App Surface, Agent Audit, MCP Security, and OWASP API Top 10 testing.",
  "author": "Team One — UMaT Ghana",

  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Open MazAPI Security Side Panel",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "web_accessible_resources": [
    { "resources": ["popup.html", "popup.js", "popup.css"], "matches": ["<all_urls>"] }
  ]
}
